{
  "name": "tp-approval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:api": "node --env-file=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/api/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "demo": "tsx scripts/local-demo.ts",
    "demo:stop": "tsx scripts/local-demo.ts --stop",
    "test:browser": "tsx tests/browser.e2e.ts",
    "test:browser:persistence": "tsx tests/browser-persistence.ts",
    "test:matrix:browser": "tsx tests/matrix.browser.ts",
    "test:registry:browser": "tsx tests/registry.browser.ts",
    "test:documents:browser": "tsx tests/documents.browser.ts",
    "test:documents:persistence": "tsx tests/documents-persistence.ts",
    "test:workplace:browser": "tsx tests/workplace.browser.ts",
    "test:contract-documents:browser": "tsx tests/contract-documents.browser.ts",
    "test:contract-documents:persistence": "tsx tests/contract-documents-persistence.ts",
    "test:riru:browser": "tsx tests/riru-review.browser.ts",
    "test:riru:persistence": "tsx tests/riru-review-persistence.ts",
    "test:engineer:browser": "tsx tests/engineer.browser.ts",
    "test:engineer:persistence": "tsx tests/engineer-persistence.ts",
    "test:review:browser": "tsx tests/review.browser.ts",
    "db:setup-local": "node --env-file=.env --import tsx scripts/setup-standalone.ts",
    "build:setup": "tsc -p tsconfig.setup.json",
    "test:standalone:browser": "node --import tsx scripts/integration.ts --standalone-browser"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "diff": "8.0.4",
    "docx-preview": "0.3.7",
    "dompurify": "3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "jszip": "3.10.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/diff": "7.0.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "17.11.0-beta.19",
    "playwright": "1.64.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
