NODE_ENV=development
AUTH_MODE=local
PORT=3000
DATABASE_URL=postgres://tp_runtime:replace-me@localhost:5432/tp_approval
MIGRATION_DATABASE_URL=postgres://postgres:replace-me@localhost:5432/tp_approval
RUNTIME_DB_PASSWORD=replace-me
# Initial standalone setup only; remove after creating the administrator.
INITIAL_ADMIN_PASSWORD=
# Local login does not need Keycloak or platform variables.
# For the existing SSO mode set AUTH_MODE=keycloak and the following:
# KEYCLOAK_ISSUER=https://auth.example.invalid/realms/platform
# KEYCLOAK_JWKS_URL=https://auth.example.invalid/realms/platform/protocol/openid-connect/certs
# KEYCLOAK_AUDIENCE=tp-approval
# PLATFORM_ORIGIN=https://platform.example.invalid
# VITE_PLATFORM_ORIGIN=https://platform.example.invalid
STORAGE_PATH=./storage
MAX_FILE_BYTES=20971520
# Production file uploads require CLAMAV_HOST; no unscanned files are accepted.
# CLAMAV_HOST=your-private-clamav-service
# Run db:setup-local for local accounts, db:bootstrap for Keycloak identities.
